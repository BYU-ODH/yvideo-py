# Copy this file to .env and adjust for each environment.
# The deployment scripts read .env to render per-checkout Podman Quadlets.
# DEPLOY_USER is the dedicated Unix account that owns this checkout and runs
# the rootless Podman/systemd user services for this one app instance.
# Keep APP_NAME equal to DEPLOY_USER unless you have a reason not to.
DEPLOY_USER=yvideo-dev
#
# APP_NAME must be unique per environment and limited to lowercase letters,
# numbers, and dashes so it is safe for the systemd service, Podman container,
# and local image tag.
APP_NAME=$DEPLOY_USER
HOST_PORT=8001

# Branch this checkout deploys from. The user-level deploy timer polls
# origin/$BRANCH every minute and, when it advances, hard-resets the
# checkout and rebuilds. Set explicitly to pin this deployment to a
# specific branch (typical for prod/staging). Leave blank to track
# whatever branch is currently checked out — useful on dev boxes where
# you switch with `git checkout`, and the next poll redeploys.
BRANCH=main

# Gunicorn tuning: start WORKERS near the CPU cores available to this
# container, and only increase THREADS if requests spend significant time
# waiting on the DB or other I/O.
WORKERS=2
THREADS=2

# International Cinema (see DEPLOY_IC.md).
# Production: run the media worker (ingest, SD transcodes, master release) as its own
# low-priority container.
IC_MEDIA_WORKER=0
# Booth: the main container becomes the userless kiosk, plus a sync-agent container
# that calls production. The booth needs no inbound ports.
IC_BOOTH=0
# Host directory for projection masters (default: <checkout>/ic_projection). Never put
# it under media/, which Apache publishes.
# IC_PROJECTION_ROOT=/srv/yvideo-prod/ic_projection
# Booth only: the deploy timer doesn't update the booth during these hours (local time,
# start inclusive, end exclusive), so a code update can't restart the kiosk mid-film.
# IC_PLAYBACK_HOURS=12-24
# Booth only: extra Chrome flags settled on by the booth spike (DEPLOY_IC.md).
# IC_CHROME_FLAGS="--enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL --ozone-platform=x11"

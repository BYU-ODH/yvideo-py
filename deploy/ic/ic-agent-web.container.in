# The booth's sync-agent web role: three signed routes on the booth LAN, opened
# by the firewall to production only. Installed when .env sets IC_BOOTH=1.
[Unit]
Description=International Cinema sync agent web for @APP_NAME@
After=@APP_NAME@.service
Requires=@APP_NAME@.service

[Container]
ContainerName=@APP_NAME@-ic-agent-web
Image=@BUILD_IMAGE_TAG@
PublishPort=@IC_AGENT_BIND@:8000
Volume=@REPO_ROOT@/data:/app/data
Volume=@REPO_ROOT@/var:/app/var
Volume=@REPO_ROOT@/yvideo/secret_settings.py:/app/yvideo/secret_settings.py:ro
Environment=YVIDEO_ROLE=ic-agent-web
Environment=IC_ROLE=agent
Environment=YVIDEO_DB_DIR=/app/data
Environment=WORKERS=1
Environment=THREADS=2
LogDriver=journald
Pull=never
SecurityLabelDisable=true

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target

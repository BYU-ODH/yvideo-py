# The booth's sync agent: polls production, runs queued force/event syncs,
# verifies, and applies. Installed when .env sets IC_BOOTH=1.
[Unit]
Description=International Cinema sync agent for @APP_NAME@
After=@APP_NAME@.service
Requires=@APP_NAME@.service

[Container]
ContainerName=@APP_NAME@-ic-sync-agent
Image=@BUILD_IMAGE_TAG@
Volume=@REPO_ROOT@/data:/app/data
Volume=@REPO_ROOT@/media:/app/media
Volume=@REPO_ROOT@/var:/app/var
Volume=@IC_PROJECTION_ROOT@:/app/ic_projection
Volume=@REPO_ROOT@/yvideo/secret_settings.py:/app/yvideo/secret_settings.py:ro
Environment=YVIDEO_ROLE=ic-sync-agent
Environment=YVIDEO_DB_DIR=/app/data
Environment=IC_PROJECTION_ROOT=/app/ic_projection
LogDriver=journald
Pull=never
SecurityLabelDisable=true

[Service]
# Sync I/O yields to playback; downloads are also throttled while a film plays.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Restart=always
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target
